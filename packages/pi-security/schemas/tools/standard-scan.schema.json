{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pi-security://schemas/tools/standard-scan.schema.json",
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]*$"
    },
    "surface": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/slug",
          "description": "A stable lowercase slug, unique within the threat model."
        },
        "label": {
          "$ref": "pi-security://schemas/definitions/artifact-common.schema.json#/$defs/nonEmptyText",
          "description": "The meaningful name of the security surface."
        },
        "description": {
          "$ref": "pi-security://schemas/definitions/artifact-common.schema.json#/$defs/nonEmptyText",
          "description": "What an attacker can reach here and which controls guard it."
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "pi-security://schemas/definitions/artifact-common.schema.json#/$defs/repositoryPath"
          },
          "description": "Target-relative files or directories that implement the surface."
        }
      },
      "required": ["id", "label", "paths"],
      "additionalProperties": false
    },
    "reportThreatModelInput": {
      "type": "object",
      "properties": {
        "content": {
          "$ref": "pi-security://schemas/definitions/artifact-common.schema.json#/$defs/nonEmptyText",
          "description": "The completed threat model as Markdown."
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface" },
          "description": "The attack surfaces discovery reviews, one discovery worker each."
        }
      },
      "required": ["content", "surfaces"],
      "additionalProperties": false
    },
    "reducedFinding": {
      "type": "object",
      "properties": {
        "candidateIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "pi-security://schemas/definitions/artifact-common.schema.json#/$defs/candidateId"
          },
          "description": "Every candidate this finding represents; the first is its primary candidate."
        },
        "ruleId": { "$ref": "pi-security://schemas/tools/scan-draft.schema.json#/$defs/finding/properties/ruleId" },
        "identity": { "$ref": "pi-security://schemas/tools/scan-draft.schema.json#/$defs/identity" },
        "title": { "$ref": "pi-security://schemas/tools/scan-draft.schema.json#/$defs/text" },
        "summary": { "$ref": "pi-security://schemas/tools/scan-draft.schema.json#/$defs/text" },
        "taxonomy": { "$ref": "pi-security://schemas/tools/scan-draft.schema.json#/$defs/taxonomy" },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "pi-security://schemas/tools/scan-draft.schema.json#/$defs/location" }
        },
        "codeEvidence": {
          "type": "array",
          "items": { "$ref": "pi-security://schemas/tools/scan-draft.schema.json#/$defs/codeEvidence" }
        },
        "rootCause": { "$ref": "pi-security://schemas/tools/scan-draft.schema.json#/$defs/text" },
        "remediation": { "$ref": "pi-security://schemas/tools/scan-draft.schema.json#/$defs/text" }
      },
      "required": ["candidateIds", "ruleId", "identity", "title", "summary", "taxonomy", "locations", "remediation"],
      "additionalProperties": false
    },
    "reportReductionInput": {
      "type": "object",
      "properties": {
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/reducedFinding" }
        },
        "rejected": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "candidateId": {
                "$ref": "pi-security://schemas/definitions/artifact-common.schema.json#/$defs/candidateId"
              },
              "reason": {
                "$ref": "pi-security://schemas/definitions/artifact-common.schema.json#/$defs/nonEmptyText"
              }
            },
            "required": ["candidateId", "reason"],
            "additionalProperties": false
          }
        }
      },
      "required": ["findings", "rejected"],
      "additionalProperties": false
    }
  }
}
