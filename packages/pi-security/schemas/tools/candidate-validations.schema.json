{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pi-security://schemas/tools/candidate-validations.schema.json",
  "title": "Record compact Pi Security candidate validations",
  "type": "object",
  "additionalProperties": false,
  "required": ["scanId", "validations"],
  "properties": {
    "scanId": {
      "$ref": "pi-security://schemas/definitions/artifact-common.schema.json#/$defs/scanId"
    },
    "validations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validationUpdate"
      }
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scanId", "validations"],
      "properties": {
        "scanId": {
          "$ref": "pi-security://schemas/definitions/artifact-common.schema.json#/$defs/scanId"
        },
        "validations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validationUpdate"
          }
        }
      }
    },
    "updatesPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validations"],
      "properties": {
        "validations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validationUpdate"
          }
        }
      }
    },
    "validationUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "validation"],
      "properties": {
        "candidateId": {
          "$ref": "pi-security://schemas/definitions/artifact-common.schema.json#/$defs/candidateId"
        },
        "validation": {
          "$ref": "#/$defs/validationRecord"
        }
      }
    },
    "validationRecord": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "disposition",
        "method",
        "confidence",
        "confidence_rationale",
        "rubric",
        "evidence",
        "counterevidence_or_proof_gap",
        "remaining_uncertainty"
      ],
      "properties": {
        "disposition": {
          "type": "string",
          "enum": ["reportable", "suppressed", "not_applicable", "deferred"]
        },
        "method": {
          "$ref": "pi-security://schemas/definitions/artifact-common.schema.json#/$defs/nonEmptyText"
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "confidence_rationale": {
          "$ref": "pi-security://schemas/definitions/artifact-common.schema.json#/$defs/nonEmptyText"
        },
        "rubric": {
          "anyOf": [
            {
              "$ref": "pi-security://schemas/definitions/artifact-common.schema.json#/$defs/nonEmptyText"
            },
            {
              "type": "object"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "anyOf": [
                  {
                    "$ref": "pi-security://schemas/definitions/artifact-common.schema.json#/$defs/nonEmptyText"
                  },
                  {
                    "type": "object"
                  }
                ]
              }
            }
          ]
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "pi-security://schemas/definitions/artifact-common.schema.json#/$defs/nonEmptyText"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "pi-security://schemas/definitions/artifact-common.schema.json#/$defs/nonEmptyText"
              }
            }
          ]
        },
        "counterevidence_or_proof_gap": {
          "type": "string"
        },
        "remaining_uncertainty": {
          "type": "string"
        },
        "artifact_paths": {
          "type": "array",
          "items": {
            "$ref": "pi-security://schemas/definitions/artifact-common.schema.json#/$defs/nonEmptyText"
          }
        },
        "source": {
          "$ref": "pi-security://schemas/definitions/artifact-common.schema.json#/$defs/nonEmptyText"
        },
        "control": {
          "$ref": "pi-security://schemas/definitions/artifact-common.schema.json#/$defs/nonEmptyText"
        },
        "sink": {
          "$ref": "pi-security://schemas/definitions/artifact-common.schema.json#/$defs/nonEmptyText"
        },
        "preconditions": {
          "anyOf": [
            {
              "$ref": "pi-security://schemas/definitions/artifact-common.schema.json#/$defs/nonEmptyText"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "pi-security://schemas/definitions/artifact-common.schema.json#/$defs/nonEmptyText"
              }
            }
          ]
        }
      }
    }
  }
}
