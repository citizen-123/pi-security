# Python-generated artifacts
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# Local scan state and databases
**/.pi-security/
**/security-scans/
**/scan-output/
**/scan-cache/
**/scans/
**/state/
**/*.db
**/*.db-journal
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.sqlite-journal
**/*.sqlite-shm
**/*.sqlite-wal
**/*.sqlite3
**/*.sqlite3-journal
**/*.sqlite3-shm
**/*.sqlite3-wal

# Temporary configuration and evaluation caches
**/.cache/
**/.eval-cache/
**/config-cache/
**/eval-cache/
**/tmp/
**/temp/
**/*.cache
**/*.cache.json
**/*.cache.toml
**/*.tmp
**/*.temp

# pi-security development-only inputs
/packages/pi-security/src/
/packages/pi-security/extensions/
/packages/pi-security/tests/
/packages/pi-security/evals/
/packages/pi-security/requirements-test.txt
/packages/pi-security/tsconfig.json
/packages/pi-security/scripts-build.mjs
/packages/pi-security/lifecycle.ts
